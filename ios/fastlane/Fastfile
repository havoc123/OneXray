require 'fileutils'

skip_docs

default_platform :ios

def flutter_build_args(*args)
  ['flutter', 'build', *args]
end

platform :ios do
  lane :deploy do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('FASTLANE_ASC_KEY_ID'),
      issuer_id: ENV.fetch('FASTLANE_ASC_ISSUER_ID'),
      key_filepath: './fastlane/AuthKey.p8'
    )

    [
      ['net.yuandev.onexray', 'OneXrayiOS'],
      ['net.yuandev.onexray.tun', 'OneXrayiOSTun']
    ].each do |app_identifier, provisioning_name|
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: app_identifier,
        provisioning_name: provisioning_name,
        ignore_profiles_with_different_name: true,
        readonly: true
      )
    end

    Dir.chdir('..') do
      sh(*flutter_build_args('ipa'))
    end

    build_app(
        skip_build_archive: true,
        archive_path: "../build/ios/archive/Runner.xcarchive",
        output_directory: File.expand_path('../../../output', __dir__),
        output_name: 'OneXray-ios',
        export_options: {
          method: 'app-store-connect',
          provisioningProfiles: {
            'net.yuandev.onexray' => 'OneXrayiOS',
            'net.yuandev.onexray.tun' => 'OneXrayiOSTun'
          }
        })
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  # ------------------------------------------------------------------
  # Self-signed / sideload builds.
  #
  #   unsigned — needs no Apple credentials. Builds Runner.app with code
  #              signing disabled and wraps it in an unencrypted IPA, ready
  #              for a local re-signing tool (zsign, iOS App Signer, ...).
  #   adhoc    — signs with a certificate and provisioning profiles supplied
  #              by the workflow. Set EXPORT_METHOD to ad-hoc, development or
  #              enterprise, and PROFILE_APP_NAME / PROFILE_TUN_NAME to the
  #              installed profile names.
  # ------------------------------------------------------------------
  lane :unsigned do
    root_dir = File.expand_path('../..', __dir__)
    output_directory = File.expand_path('../../../output', __dir__)

    Dir.chdir(root_dir) do
      sh(*flutter_build_args('ios', '--release', '--no-codesign'))
    end

    app_path = File.join(root_dir, 'build', 'ios', 'iphoneos', 'Runner.app')
    unless Dir.exist?(app_path)
      app_path = Dir.glob(File.join(root_dir, 'build', 'ios', '**', 'Runner.app')).first
    end
    raise "Runner.app was not produced under #{File.join(root_dir, 'build', 'ios')}" if app_path.nil? || !Dir.exist?(app_path)

    FileUtils.mkdir_p(output_directory)
    payload_path = File.join(output_directory, 'Payload')
    FileUtils.rm_rf(payload_path)
    FileUtils.mkdir_p(payload_path)
    FileUtils.cp_r(app_path, payload_path)

    ipa_name = ENV.fetch('IPA_NAME', 'OneXray-ios-unsigned')
    Dir.chdir(output_directory) do
      ipa_path = "#{ipa_name}.ipa"
      FileUtils.rm_f(ipa_path)
      sh('zip', '-qry', ipa_path, 'Payload')
      FileUtils.rm_rf('Payload')
    end
  end

  lane :adhoc do
    Dir.chdir('..') do
      sh(*flutter_build_args('ipa'))
    end

    build_app(
      skip_build_archive: true,
      archive_path: '../build/ios/archive/Runner.xcarchive',
      output_directory: File.expand_path('../../../output', __dir__),
      output_name: ENV.fetch('IPA_NAME', 'OneXray-ios'),
      export_options: {
        method: ENV.fetch('EXPORT_METHOD', 'ad-hoc'),
        provisioningProfiles: {
          ENV.fetch('BUNDLE_ID_APP', 'net.yuandev.onexray') => ENV.fetch('PROFILE_APP_NAME'),
          ENV.fetch('BUNDLE_ID_TUN', 'net.yuandev.onexray.tun') => ENV.fetch('PROFILE_TUN_NAME')
        }
      }
    )
  end

  after_all do |lane|
  end

  error do |lane, exception|
  end
end
